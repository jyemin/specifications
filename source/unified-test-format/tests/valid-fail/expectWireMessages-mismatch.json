{
  "description": "expectWireMessages-mismatch",
  "schemaVersion": "1.30",
  "createEntities": [
    {
      "client": {
        "id": "client0",
        "uriOptions": {
          "maxPoolSize": 1
        },
        "observeWireMessages": {
          "connections": [
            "application"
          ],
          "phases": [
            "operation"
          ]
        }
      }
    },
    {
      "database": {
        "id": "database0",
        "client": "client0",
        "databaseName": "expectWireMessages-mismatch"
      }
    }
  ],
  "tests": [
    {
      "description": "a key that was written but is not expected fails the match",
      "operations": [
        {
          "name": "runCommand",
          "object": "database0",
          "arguments": {
            "commandName": "ping",
            "command": {
              "ping": 1
            }
          }
        }
      ],
      "expectWireMessages": [
        {
          "client": "client0",
          "messages": [
            {
              "opcode": "OP_MSG",
              "responseTo": 0,
              "flags": [],
              "command": {
                "ping": 1,
                "lsid": {
                  "$$unsetOrMatches": {
                    "$$type": "object"
                  }
                },
                "$clusterTime": {
                  "$$unsetOrMatches": {
                    "$$type": "object"
                  }
                },
                "$readPreference": {
                  "$$unsetOrMatches": {
                    "$$type": "object"
                  }
                }
              }
            }
          ]
        }
      ]
    },
